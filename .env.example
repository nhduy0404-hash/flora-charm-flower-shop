APP_NAME="Flower Shop"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Cấu hình CSDL khi chạy Laragon / XAMPP cục bộ:
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=flower_shop
DB_USERNAME=root
DB_PASSWORD=

# Cấu hình CSDL khi chạy Docker (bỏ comment nếu chạy Docker):
# DB_HOST=db
# DB_PORT=3306
# DB_DATABASE=flower_shop
# DB_USERNAME=flower_user
# DB_PASSWORD=flower_password

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@flowershop.vn"
MAIL_FROM_NAME="${APP_NAME}"

# Cấu hình chuyển khoản ngân hàng VietQR tự động:
VIETQR_BANK_ID=MB
VIETQR_ACCOUNT_NO=0369710409
VIETQR_ACCOUNT_NAME="FLORA CHARM"
